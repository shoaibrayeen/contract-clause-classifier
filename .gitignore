# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Environments ---
.venv/
venv/
.env
.env.*
!.env.example

# --- Data ---
# The raw LEDGAR parquet files (28 MB, CC BY 4.0) ARE committed so a clone works offline and everyone
# trains on identical data. The tokenised cache is regenerated by scripts/01_prepare_data.py.
data/cache/
data/raw/*
!data/raw/README.md
!data/raw/ledgar/
data/raw/ledgar/*
!data/raw/ledgar/train.parquet
!data/raw/ledgar/validation.parquet
!data/raw/ledgar/test.parquet
!data/raw/ledgar/labels.json
!data/raw/ledgar/README.md

# --- Training outputs (checkpoints, merged models, metrics) ---
artifacts/*
!artifacts/.gitkeep

# --- Model / tensor files anywhere ---
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.onnx

# --- Hugging Face cache if HF_HOME is pointed inside the repo ---
.cache/
hf_cache/

# --- Notebooks ---
.ipynb_checkpoints/

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
*.swp

# --- Local agent state (shared agent docs like CLAUDE.md / AGENTS.md ARE committed) ---
.claude/settings.local.json

# --- Logs ---
*.log
logs/
