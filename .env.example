# Copy to .env and adjust. Read by the API (scripts/05_serve.py and Docker).
RUNS_DIR=artifacts/runs               # every completed run here is served (artifacts/runs/<run>-v<N>/merged)
MODEL_ID=clause-classifier-qwen3-0.6b # alias that always means the latest version (besides "latest")
MAX_LOADED_MODELS=2                   # versions kept in memory at once (LRU)
MODEL_RESCAN_SECONDS=5                # how often new versions are picked up without a restart
LABEL_GROUPS=configs/ledgar_label_groups.yaml   # clause-type grouping for /v1/dataset and /v1/labels
# MODEL_DIR=/path/to/some/merged      # optional extra model directory outside RUNS_DIR
DATA_DIR=data                         # LEDGAR parquet location for /v1/dataset
DEVICE=auto                           # auto | mps | cuda | cpu   (Docker: cpu)
TOP_K=3                               # labels returned per clause
THRESHOLD=0.30                        # min confidence to list a label (top-1 always listed)
BATCH_SIZE=16                         # inference batch size
# API_KEY=change-me                   # if set, /v1/* requires "Authorization: Bearer <key>"
# CORS_ORIGINS=*                      # comma-separated
# MAX_INPUT_CHARS=2000000
